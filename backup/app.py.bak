        if not job_name:
            return jsonify({
                'status': 'error',
                'message': "Job name is required"
            }), 400
            
        if not model_name:
            return jsonify({
                'status': 'error',
                'message': "Model name is required"
            }), 400
            
        if not training_file_ids:
            return jsonify({
                'status': 'error',
                'message': "At least one training file ID is required"
            }), 400
            
        # Initialize the fine-tuning manager
        from utils.fine_tuning import FineTuningManager
        ft_manager = FineTuningManager()
        
        # Create the job
