            job_name=job_name,
            model_name=model_name,
            training_file_ids=training_file_ids,
            parameters=parameters
        )
        
        if job:
            return jsonify({
                'status': 'success',
                'job_id': job.id,
                'message': f"Fine-tuning job created successfully with ID {job.id}"
            })
        else:
